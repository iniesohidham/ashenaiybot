# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
# Runtime mode for the backend process.
NODE_ENV=development
# Port the bot-api Fastify server listens on.
PORT=3000

# --- Telegram ---
# Bot token issued by @BotFather. Required for the grammY bot to authenticate.
TELEGRAM_BOT_TOKEN=
# Secret token Telegram sends back on webhook requests, used to verify calls actually came from Telegram.
TELEGRAM_WEBHOOK_SECRET=

# --- Database (Postgres) ---
# Full connection string used by Prisma.
DATABASE_URL=postgresql://ashena:ashena@localhost:5432/ashena?schema=public
# Individual values used by the Postgres container itself (docker-compose).
POSTGRES_USER=ashena
POSTGRES_PASSWORD=ashena
POSTGRES_DB=ashena

# --- Redis ---
# Connection string for matchmaking queue, session state, rate-limit counters, and BullMQ.
REDIS_URL=redis://localhost:6379

# --- Chat relay (apps/bot-api, EPIC 4) ---
# Hours a ChatSession can sit with no messages before the worker auto-ends it. Optional, defaults to 24.
IDLE_SESSION_TIMEOUT_HOURS=24

# --- Analytics/Observability (apps/bot-api, EPIC 8) ---
# JSON log verbosity (pino level name: trace/debug/info/warn/error/fatal). Optional, defaults to info.
LOG_LEVEL=info
# Days of no activity before the inactivity-nudge job considers a user for a re-engagement message. Optional, defaults to 3.
INACTIVITY_NUDGE_DAYS=3
# Grafana's admin login password (docker-compose.yml's grafana service). Falls back to the obvious placeholder "ChangeMe123!" if unset (see docker-compose.yml's comment) — always set a real value before deploying.
GRAFANA_ADMIN_PASSWORD=

# --- Mini App (apps/web-miniapp) ---
# Public base URL of the Mini App, used to build the /start "web_app" button.
MINIAPP_PUBLIC_URL=http://localhost:3001
# Base URL of apps/bot-api's REST server. In local dev, backs
# web-miniapp's next.config.ts rewrite so its relative /api/* calls reach
# bot-api without CORS (unused in production there — nginx already
# same-origins /api/* for the Mini App). EPIC 7's apps/web-admin uses this
# same var differently: its Next.js server (NextAuth's authorize(),
# Route Handlers/Server Components) calls bot-api directly over the network
# — this one IS needed in production too, set to the internal Docker
# hostname (e.g. http://api:3000 in docker-compose.yml's network).
BOT_API_URL=http://localhost:3000

# --- Admin Panel (apps/web-admin) ---
# NextAuth session encryption secret. Generate with `openssl rand -base64 32`.
NEXTAUTH_SECRET=
# Canonical URL of the admin panel, required by NextAuth. Includes the
# `/admin` basePath (see next.config.ts) — nginx forwards the full
# `/admin/...` path through unchanged (nginx/conf.d/default.conf has no
# trailing slash on `proxy_pass http://web_admin;`), so Next must actually
# serve under that prefix, in dev too.
NEXTAUTH_URL=http://localhost:3002/admin
# Shared HS256 secret between apps/bot-api and apps/web-admin, used to sign/
# verify the short-lived admin API token minted at login (US-7.1) — distinct
# from NEXTAUTH_SECRET (that one only protects web-admin's own session
# cookie). Generate with `openssl rand -base64 32`. Must be identical on
# both apps.
ADMIN_API_SECRET=
