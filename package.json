{
  "name": "ashenaiybot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter=\"./packages/*\" run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "eslint .",
    "typecheck": "pnpm run build:packages && pnpm -r run typecheck",
    "test": "vitest run",
    "db:generate": "pnpm --filter @ashena/db run generate",
    "db:migrate": "pnpm --filter @ashena/db run migrate:dev",
    "db:seed": "pnpm --filter @ashena/db run seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
