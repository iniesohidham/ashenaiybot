generator client {
  provider = "prisma-client-js"
  // EPIC 8 live-verification pass discovered this: with no explicit
  // binaryTargets, `prisma generate` running inside the Docker build stage
  // (node:22-alpine) mis-detects the runtime's OpenSSL version and falls
  // back to an "openssl-1.1.x" engine binary — but modern Alpine ships only
  // OpenSSL 3.x (no libssl.so.1.1), so the runner stage's `node dist/index.js`
  // crash-loops on `Error loading shared library libssl.so.1.1: No such
  // file or directory`. This went uncaught by every prior epic's own "live
  // verification" because none of them ran the actual prod
  // docker-compose.yml multi-stage build+runner — EPIC 2/3/4/5's live-bot
  // passes ran `tsx` directly, EPIC 6/7's live passes used
  // docker-compose.dev.yml (bind-mounts source over the `deps` stage,
  // `pnpm dev`, never reaches this `runner` stage at all). Explicit
  // binaryTargets sidesteps the misdetection entirely by naming the correct
  // pre-built engine instead of relying on runtime auto-detection.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// EPIC 1 (US-1.1) — core data model. See ashenaiybot-prd-and-backlog.md §6.
// ---------------------------------------------------------------------------

enum Gender {
  male
  female
  other
}

enum UserStatus {
  active
  banned
  deleted
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum SwipeActionType {
  like
  pass
}

enum MatchStatus {
  active
  ended
}

enum ChatSessionEndReason {
  user_ended
  reported
  blocked
  banned
  idle_timeout
}

enum MessageType {
  text
  photo
  voice
  sticker
}

enum ReportReason {
  harassment
  unwanted_content
  suspected_minor
  spam
  other
}

enum ReportSeverity {
  normal
  high
}

enum ReportStatus {
  pending
  reviewed
  actioned
}

// EPIC 5 (US-5.3) — the action a moderator took when resolving a Report.
enum ReportResolutionAction {
  no_action
  warn
  temporary_ban
  permanent_ban
}

// EPIC 5 (US-5.5) — outcome of a ban appeal review.
enum BanAppealStatus {
  pending
  upheld
  reversed
}

enum AdminRole {
  admin
  moderator
}

enum BanType {
  temporary
  permanent
}

// EPIC 7 (US-7.7) — a durable record of a broadcast send, since a BullMQ
// job's own return value isn't queryable later from a different process
// (web-admin polling for delivery counts after the request that queued it
// has already returned).
enum BroadcastStatus {
  pending
  sending
  completed
}

// EPIC 8 (US-8.3) — the fixed set of product events tracked in the Event
// table. Deliberately narrow (not one row per message/swipe) — see
// modules/events/service.ts's doc comment for why DAU stays computed from
// operational tables rather than this log.
enum EventType {
  signup_completed
  match_created
  chat_ended
  report_submitted
}

model User {
  id            String     @id @default(cuid())
  telegramId    BigInt     @unique
  // Null until EPIC 2 onboarding collects it — US-1.4 creates a bare User
  // row on first Telegram contact, before gender/birthDate are known.
  gender        Gender?
  birthDate     DateTime?  @db.Date
  languageCode  String?
  status        UserStatus @default(active)
  // Set once the user taps through the 18+ attestation in EPIC 2 (US-2.2).
  ageAttestedAt DateTime?
  createdAt     DateTime   @default(now())
  // EPIC 8 (US-8.4) — updated on every resolved bot/Mini-App request
  // (modules/users/service.ts's findOrCreateUserByTelegramId, the single
  // choke point both surfaces already resolve identity through), so the
  // inactivity-nudge job can find users idle past a threshold without a
  // dedicated "last seen" event stream.
  lastActiveAt          DateTime?
  // US-8.4's opt-out AC — surfaced in both bot Settings and Mini App
  // Settings (dual-surface parity), defaults to false (opted in).
  notificationsOptedOut Boolean   @default(false)
  // Guards "at most one nudge per period" — set by the worker job when a
  // nudge is actually sent, checked (not just lastActiveAt) so a user who
  // stays inactive for months gets one nudge per period, not one every job
  // tick.
  lastNudgeSentAt       DateTime?

  profile Profile?
  matchPreference MatchPreference?
  // EPIC 8 (US-8.3) — SetNull (not Cascade), same reasoning as
  // Message.matchedPattern: a historical event record should survive the
  // user later being soft-deleted, for audit/analytics continuity.
  events Event[]

  swipesMade     SwipeAction[] @relation("SwipeActor")
  swipesReceived SwipeAction[] @relation("SwipeTarget")

  matchesAsUserA Match[] @relation("MatchUserA")
  matchesAsUserB Match[] @relation("MatchUserB")

  messagesSent Message[]

  reportsFiled    Report[] @relation("ReportReporter")
  reportsReceived Report[] @relation("ReportReported")

  blocksInitiated Block[] @relation("BlockBlocker")
  blocksReceived  Block[] @relation("BlockBlocked")

  banRecords        BanRecord[]
  banAppeals        BanAppeal[]
  endedChatSessions ChatSession[] @relation("ChatSessionEndedBy")

  @@index([status])
}

model Profile {
  id                    String           @id @default(cuid())
  userId                String           @unique
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayBio            String?
  interests             String[]         @default([])
  photoUrl              String?
  photoModerationStatus ModerationStatus @default(pending)
  // EPIC 5 (US-5.2) — when the current photoUrl was submitted; set whenever
  // a new photo is uploaded (see modules/profiles/service.ts's
  // upsertProfile). Orders the manual review queue oldest-first, same
  // convention as Report's severity-then-createdAt ordering (US-5.3) — there
  // is no automated classifier yet (see moderation service's doc comment),
  // so every photo waits here until a moderator decision lands (EPIC 7).
  photoSubmittedAt      DateTime?
}

// EPIC 3 (US-3.1) — who a user wants to see in their candidate queue. Lazily
// created with sensible defaults (see matching service) the first time it's
// needed, not eagerly at onboarding, so pre-EPIC-3 users backfill naturally.
model MatchPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interestedInGenders Gender[]
  minAge              Int
  maxAge              Int
}

model SwipeAction {
  id           String          @id @default(cuid())
  actorUserId  String
  actor        User            @relation("SwipeActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetUserId String
  target       User            @relation("SwipeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  action       SwipeActionType
  createdAt    DateTime        @default(now())

  // Prevents duplicate swipes from double-taps (US-3.3) at the DB level.
  @@unique([actorUserId, targetUserId])
}

model Match {
  id          String      @id @default(cuid())
  // Service layer must always store the lexicographically/numerically
  // smaller user id as userAId so this unique constraint catches a duplicate
  // match regardless of like order (US-3.4) — Prisma can't express an
  // unordered-pair constraint directly.
  userAId     String
  userA       User        @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId     String
  userB       User        @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  status      MatchStatus @default(active)
  createdAt   DateTime    @default(now())
  endedReason String?

  chatSessions ChatSession[]

  @@unique([userAId, userBId])
}

model ChatSession {
  id            String                @id @default(cuid())
  matchId       String
  match         Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  startedAt     DateTime              @default(now())
  endedAt       DateTime?
  endedReason   ChatSessionEndReason?
  // Null when the session ended for a system reason (e.g. idle_timeout)
  // rather than a specific user's action.
  endedByUserId String?
  endedByUser   User?                 @relation("ChatSessionEndedBy", fields: [endedByUserId], references: [id])

  messages Message[]
  reports  Report[]

  @@index([matchId])
}

model Message {
  id             String      @id @default(cuid())
  sessionId      String
  session        ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User        @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  type           MessageType
  // Text content for type=text; a storage reference/file id for media types.
  contentRef     String
  sentAt         DateTime    @default(now())
  moderationFlag Boolean     @default(false)
  // EPIC 5 (US-5.1) — which BannedPattern tripped moderationFlag, if any.
  // Nullable and onDelete: SetNull (not Cascade) — a historical flagged
  // message must survive an admin later editing/removing the pattern list
  // (US-7.5), otherwise false-positive-rate monitoring loses its own
  // evidence the moment the offending pattern is fixed.
  matchedPatternId String?
  matchedPattern   BannedPattern? @relation(fields: [matchedPatternId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  // EPIC 5 (US-5.6) — spam-pattern detection queries recent messages by
  // sender within a time window (see modules/moderation/service.ts).
  @@index([senderUserId, sentAt])
}

model Report {
  id         String @id @default(cuid())
  // Nullable: a null reporter means this Report was auto-created by the
  // keyword filter (US-5.1's "auto-flagged for moderator review"), not
  // submitted by a user (US-4.5's report flow always sets this).
  reporterId String?
  reporter   User?  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String
  reportedUser   User           @relation("ReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        ChatSession?   @relation(fields: [sessionId], references: [id])
  reason         ReportReason
  severity       ReportSeverity @default(normal)
  status         ReportStatus   @default(pending)
  createdAt      DateTime       @default(now())
  // EPIC 5 (US-5.3) — set together when a moderator resolves this report;
  // resolvedAt - createdAt is the G3 SLA metric (getReportSlaStats()).
  resolvedAt        DateTime?
  resolvedByAdminId String?
  resolvedByAdmin   AdminUser?             @relation("ReportResolvedBy", fields: [resolvedByAdminId], references: [id])
  resolutionAction  ReportResolutionAction?

  @@index([status, severity, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         AdminRole
  createdAt    DateTime  @default(now())

  issuedBans      BanRecord[]
  resolvedReports Report[]    @relation("ReportResolvedBy")
  resolvedAppeals BanAppeal[] @relation("BanAppealResolvedBy")
  broadcastsSent  Broadcast[]
}

// EPIC 7 (US-7.7) — one row per broadcast send. totalTargeted is snapshotted
// at enqueue time (the audience the admin actually confirmed sending to);
// successCount/failureCount are updated incrementally by the worker as
// ashena-broadcast's send-broadcast job works through the list, so
// web-admin can poll this row for live progress rather than needing to hold
// a request open for however long the whole send takes.
model Broadcast {
  id              String          @id @default(cuid())
  message         String
  createdByAdminId String
  createdByAdmin  AdminUser       @relation(fields: [createdByAdminId], references: [id])
  status          BroadcastStatus @default(pending)
  totalTargeted   Int
  successCount    Int             @default(0)
  failureCount    Int             @default(0)
  createdAt       DateTime        @default(now())
  completedAt     DateTime?
}

// EPIC 5 (US-5.1, minimal slice) — banned-word/pattern list, editable without a
// code deploy. Literal case-insensitive substring matching only for v1 (no
// regex engine exposed) — see modules/moderation/service.ts.
model BannedPattern {
  id        String         @id @default(cuid())
  pattern   String
  severity  ReportSeverity @default(normal)
  createdAt DateTime       @default(now())

  matchedMessages Message[]
}

model BanRecord {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason          String
  type            BanType
  expiresAt       DateTime?
  issuedByAdminId String
  issuedByAdmin   AdminUser @relation(fields: [issuedByAdminId], references: [id])
  createdAt       DateTime  @default(now())

  appeal BanAppeal?

  @@index([userId])
}

// EPIC 5 (US-5.5) — a banned user's request to have their ban reconsidered.
// One-to-one with BanRecord (@unique banRecordId) enforces "at most one
// appeal per ban" at the DB level rather than relying solely on an
// app-level check-then-create (see modules/moderation/service.ts's
// hasAppealForBan/submitBanAppeal).
model BanAppeal {
  id                String          @id @default(cuid())
  banRecordId       String          @unique
  banRecord         BanRecord       @relation(fields: [banRecordId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  message           String
  status            BanAppealStatus @default(pending)
  createdAt         DateTime        @default(now())
  resolvedAt        DateTime?
  resolvedByAdminId String?
  resolvedByAdmin   AdminUser?      @relation("BanAppealResolvedBy", fields: [resolvedByAdminId], references: [id])

  @@index([status, createdAt])
}

// EPIC 8 (US-8.3) — a queryable log of key product events, backing the
// Admin dashboard (US-7.6) instead of the ad-hoc per-metric Prisma queries
// getDashboardMetrics() used before this epic. userId is nullable + SetNull
// (not every event is attributable to a single user — e.g. match_created
// involves two — and a historical event must survive that user's later
// soft-deletion, same convention as Message.matchedPattern). metadata is a
// free-form JSON bag (e.g. { matchId }, { sessionId, reason }) — no schema
// enforced on it, same "no extra migration per new metadata field" tradeoff
// BannedPattern's flat shape already accepts elsewhere in this schema.
model Event {
  id        String    @id @default(cuid())
  type      EventType
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([type, createdAt])
  @@index([userId])
}
