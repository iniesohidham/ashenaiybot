# Template only — nginx's conf.d include only picks up *.conf, so this file
# has no effect until you finish these steps:
#   1. Put a real certificate + key at nginx/certs/fullchain.pem and
#      nginx/certs/privkey.pem (e.g. via certbot).
#   2. Uncomment `return 301 https://$host$request_uri;` in
#      nginx/conf.d/default.conf so port 80 redirects instead of serving.
#   3. Rename this file to ssl.conf.
#
# upstream_bot_api / web_miniapp / web_admin are defined once in default.conf
# and are visible here too since both files share the same http{} block.

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://bot_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        proxy_pass http://web_admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://web_miniapp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
